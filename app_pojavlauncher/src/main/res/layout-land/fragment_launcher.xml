<?xml version="1.0" encoding="utf-8"?>
<!--
    Two-pane landscape main menu: the actions stay in the left sidebar while every screen
    (add instance, accounts, editors, modpack search, ...) opens in the right pane.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <!-- Left sidebar = 33%, right pane = 67% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pane_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <!-- ══════════════ LEFT SIDEBAR ══════════════ -->
    <ScrollView
        android:id="@+id/left_sidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pane_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/left_sidebar_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/padding_large">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:paddingHorizontal="@dimen/padding_heavy"
                android:paddingTop="@dimen/padding_large"
                android:paddingBottom="@dimen/padding_medium"
                android:text="@string/mcl_section_quick_actions"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/_11ssp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/mod_store_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_add"
                android:text="@string/mcl_button_mod_store" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_gamepad"
                android:text="@string/mcl_option_customcontrol" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:paddingHorizontal="@dimen/padding_heavy"
                android:paddingTop="@dimen/padding_large"
                android:paddingBottom="@dimen/padding_medium"
                android:text="@string/mcl_section_instance_tools"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/_11ssp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_folder"
                android:text="@string/mcl_button_open_directory" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_java_run"
                android:text="@string/main_install_jar_file" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_sharelog"
                android:text="@string/main_share_logs" />
        </LinearLayout>
    </ScrollView>

    <!-- ══════════════ RIGHT PANE ══════════════
         Hosts the home screen by default and every screen opened from the sidebar or the version bar.
         When the bottom bar is hidden it collapses, and the pane grows to fill the height. -->
    <FrameLayout
        android:id="@+id/right_pane_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_right_pane"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/pane_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="8dp" />

    <!-- ══════════════ BOTTOM BAR: instance selection and play, only shown on the home screen ══════════════ -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/pane_guideline">

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_popup_rounded"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_32sdp" />

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_px_edit" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/_96sdp"
            android:text="@string/main_play"
            android:textAllCaps="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
