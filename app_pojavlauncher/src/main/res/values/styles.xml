<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme presets below are ported from CopperLauncher/Copper-Android's
         ThemeManager. The "flat" style of each preset only re-tints the accent
         and text colors so existing installs keep their current dark
         background; picking the "Gradient" toggle switches on the full
         per-preset background/status-bar colors and gradient drawable, same
         as upstream. -->

    <!-- ── Default (Copper) ─────────────────────────────────── -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="colorBgApp">@color/background_app</item>
        <item name="colorBgBottomBar">@color/background_bottom_bar</item>
        <item name="colorBgStatusBar">@color/background_status_bar</item>
        <item name="colorDivider">@color/divider</item>
        <item name="copperAccent">@color/minebutton_color</item>
        <item name="colorTextPrimary">@color/primary_text</item>
        <item name="colorTextSecondary">@color/secondary_text</item>
        <item name="bgMainDrawable">@color/background_app</item>
    </style>
    <style name="AppTheme.Gradient">
        <item name="bgMainDrawable">@drawable/bg_gradient_copper</item>
        <item name="android:windowBackground">@drawable/bg_gradient_copper</item>
        <item name="colorBgBottomBar">@color/background_bottom_bar</item>
        <item name="colorBgStatusBar">@color/background_status_bar</item>
    </style>

    <!-- ── Midnight Blue ────────────────────────────────────── -->
    <style name="AppTheme.MidnightBlue">
        <item name="copperAccent">@color/mb_accent</item>
        <item name="colorTextPrimary">@color/mb_text_primary</item>
        <item name="colorTextSecondary">@color/mb_text_secondary</item>
    </style>
    <style name="AppTheme.MidnightBlue.Gradient">
        <item name="android:statusBarColor">@color/mb_bg_status_bar</item>
        <item name="android:navigationBarColor">@color/mb_bg_app</item>
        <item name="bgMainDrawable">@drawable/bg_gradient_midnight_blue</item>
        <item name="android:windowBackground">@drawable/bg_gradient_midnight_blue</item>
        <item name="colorBgApp">@color/mb_bg_app</item>
        <item name="colorBgBottomBar">@color/mb_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/mb_bg_status_bar</item>
        <item name="colorDivider">@color/mb_divider</item>
    </style>

    <!-- ── Forest Green ─────────────────────────────────────── -->
    <style name="AppTheme.ForestGreen">
        <item name="copperAccent">@color/fg_accent</item>
        <item name="colorTextPrimary">@color/fg_text_primary</item>
        <item name="colorTextSecondary">@color/fg_text_secondary</item>
    </style>
    <style name="AppTheme.ForestGreen.Gradient">
        <item name="android:statusBarColor">@color/fg_bg_status_bar</item>
        <item name="android:navigationBarColor">@color/fg_bg_app</item>
        <item name="bgMainDrawable">@drawable/bg_gradient_forest_green</item>
        <item name="android:windowBackground">@drawable/bg_gradient_forest_green</item>
        <item name="colorBgApp">@color/fg_bg_app</item>
        <item name="colorBgBottomBar">@color/fg_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/fg_bg_status_bar</item>
        <item name="colorDivider">@color/fg_divider</item>
    </style>

    <!-- ── Crimson ───────────────────────────────────────────── -->
    <style name="AppTheme.Crimson">
        <item name="copperAccent">@color/cr_accent</item>
        <item name="colorTextPrimary">@color/cr_text_primary</item>
        <item name="colorTextSecondary">@color/cr_text_secondary</item>
    </style>
    <style name="AppTheme.Crimson.Gradient">
        <item name="android:statusBarColor">@color/cr_bg_status_bar</item>
        <item name="android:navigationBarColor">@color/cr_bg_app</item>
        <item name="bgMainDrawable">@drawable/bg_gradient_crimson</item>
        <item name="android:windowBackground">@drawable/bg_gradient_crimson</item>
        <item name="colorBgApp">@color/cr_bg_app</item>
        <item name="colorBgBottomBar">@color/cr_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/cr_bg_status_bar</item>
        <item name="colorDivider">@color/cr_divider</item>
    </style>

    <!-- ── Amethyst ──────────────────────────────────────────── -->
    <style name="AppTheme.Amethyst">
        <item name="copperAccent">@color/am_accent</item>
        <item name="colorTextPrimary">@color/am_text_primary</item>
        <item name="colorTextSecondary">@color/am_text_secondary</item>
    </style>
    <style name="AppTheme.Amethyst.Gradient">
        <item name="android:statusBarColor">@color/am_bg_status_bar</item>
        <item name="android:navigationBarColor">@color/am_bg_app</item>
        <item name="bgMainDrawable">@drawable/bg_gradient_amethyst</item>
        <item name="android:windowBackground">@drawable/bg_gradient_amethyst</item>
        <item name="colorBgApp">@color/am_bg_app</item>
        <item name="colorBgBottomBar">@color/am_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/am_bg_status_bar</item>
        <item name="colorDivider">@color/am_divider</item>
    </style>

    <!-- ── Arctic ───────────────────────────────────────────── -->
    <style name="AppTheme.Arctic">
        <item name="copperAccent">@color/ar_accent</item>
        <item name="colorTextPrimary">@color/ar_text_primary</item>
        <item name="colorTextSecondary">@color/ar_text_secondary</item>
    </style>
    <style name="AppTheme.Arctic.Gradient">
        <item name="android:statusBarColor">@color/ar_bg_status_bar</item>
        <item name="android:navigationBarColor">@color/ar_bg_app</item>
        <item name="bgMainDrawable">@drawable/bg_gradient_arctic</item>
        <item name="android:windowBackground">@drawable/bg_gradient_arctic</item>
        <item name="colorBgApp">@color/ar_bg_app</item>
        <item name="colorBgBottomBar">@color/ar_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/ar_bg_status_bar</item>
        <item name="colorDivider">@color/ar_divider</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">?attr/colorDivider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
